# Enable automatic 1080x1920 exports for paid and Autopilot accounts.
# Defaults to false when unset. Account-level admin overrides still take precedence.
EXPORT_1080_FOR_PAID=false

# Temporarily hidden Comments navigation, routes, Publishing UI, and sync jobs.
# Defaults to false when unset.
COMMENTS_ENABLED=false

# Optional postal-address line for signup-sequence email footers.
COMPANY_POSTAL_ADDRESS=""
NURTURE_ENABLED=false
NURTURE_DAILY_CAP=40
STRIPE_PRICE_AUTOPILOT_15_MONTH=
STRIPE_PRICE_AUTOPILOT_30_MONTH=
STRIPE_PRICE_AUTOPILOT_45_MONTH=
STRIPE_PRICE_AUTOPILOT_60_MONTH=

# AI covers remain disabled until globally enabled and opted in per brand.
AI_COVERS_ENABLED=false
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
AI_COVER_MONTHLY_CAP=60
